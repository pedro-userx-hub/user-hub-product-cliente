{
  "name": "@userx/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design system UserX — tokens e componentes base. Espelha design-system/ (Figma legado). Incremental: só o que as stories consomem.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./global.css": "./src/global.css"
  },
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretypecheck": "npm run tokens:build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.2"
  }
}
